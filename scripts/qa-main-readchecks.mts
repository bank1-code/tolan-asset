import "dotenv/config";
import {readFileSync,writeFileSync} from "node:fs";
import {strict as assert} from "node:assert";
import mysql from "mysql2/promise";
import {appRouter} from "../server/routers";
import {getDb} from "../server/db";
const run=JSON.parse(readFileSync("qa-results/run.json","utf8")),d=JSON.parse(readFileSync("qa-results/discovery.json","utf8"));
const context=(user:any)=>({user,req:{ip:"127.0.0.1",headers:{}},res:{}}as any),maker=appRouter.createCaller(context(d.users.find((u:any)=>u.id===run.actors.maker.id))),owner=appRouter.createCaller(context(d.users.find((u:any)=>u.id===run.actors.reviewer.id)));
const db=await mysql.createConnection({uri:process.env.DATABASE_URL!,ssl:{minVersion:"TLSv1.2",rejectUnauthorized:true}}),out:any={marker:run.marker,checks:[],startedAt:new Date().toISOString()};
async function check(name:string,fn:()=>Promise<any>){try{const evidence=await fn();out.checks.push({name,status:"PASS",evidence});console.log(`PASS ${name}`);}catch(e:any){out.checks.push({name,status:"FAIL",error:e.message,code:e.code});console.log(`FAIL ${name}: ${e.message}`);}writeFileSync("qa-results/main-readchecks.json",JSON.stringify(out,null,2));}
try{
 const [a]=await db.query<any[]>("SELECT * FROM assets WHERE assetName LIKE ?",[`%${run.marker}%`]),[c]=await db.query<any[]>("SELECT * FROM custody_items WHERE name LIKE ?",[`%${run.marker}%`]);const records=[...a.map((r:any)=>({...r,entityType:"asset"})),...c.map((r:any)=>({...r,entityType:"custody"}))];
 await check("عدد السجلات والحالات الفعلية والكميات الأصلية والمستبعدة والضمان",async()=>{assert.equal(a.length,40);assert.equal(c.length,30);for(const r of records){const remaining=r.quantity-(r.excludedQuantity??0)-(r.warrantyReplacedQuantity??0);assert.ok(remaining>=0);if(r.status==="ACTIVE")assert.ok(remaining>0);if(["EXCLUDED","REPLACED"].includes(r.status))assert.equal(remaining,0);assert.ok(r.classificationId);}return{assets:a.length,custody:c.length,statuses:records.reduce((n:any,r:any)=>(n[r.status]=(n[r.status]??0)+1,n),{}),units:records.reduce((n,r)=>n+r.quantity,0)};});
 const active=records.filter((r:any)=>r.status==="ACTIVE"&&r.quantity-r.excludedQuantity-r.warrantyReplacedQuantity>0),first=active[0],dept=d.departments.find((x:any)=>x.id===first.departmentId),branch=d.branches.find((x:any)=>x.id===dept.branchId);
 const filters=[{name:"الموقع",locationId:first.locationId},{name:"الفرع وحده",branchId:branch.id},{name:"القسم وحده",departmentId:first.departmentId},{name:"الموظف وحده",employeeId:first.assignedTo},{name:"هجين",locationId:first.locationId,departmentId:first.departmentId,employeeId:first.assignedTo},{name:"الموقع الثاني الفارغ",locationId:d.locations.find((l:any)=>l.id!==first.locationId).id}];
 for(const filter of filters)for(const sessionType of ["assets","custody","both"]as const)await check(`مطابقة فلتر ${filter.name} / ${sessionType} مع السجلات الفعلية`,async()=>{const {name,...scope}=filter;const got=await maker.inventoryCount.previewScope({sessionType,search:run.marker,...scope});const expected=active.filter(r=>((sessionType==="both")||(sessionType==="assets"&&r.entityType==="asset")||(sessionType==="custody"&&r.entityType==="custody"))&&(!scope.locationId||r.locationId===scope.locationId)&&(!scope.departmentId||r.departmentId===scope.departmentId)&&(!scope.employeeId||r.assignedTo===scope.employeeId)&&(!scope.branchId||d.departments.find((x:any)=>x.id===r.departmentId)?.branchId===scope.branchId));const key=(r:any)=>`${r.entityType}:${r.id}`;assert.deepEqual(got.items.map(key).sort(),expected.map(key).sort());return{count:got.items.length};});
 await check("المحاسب لا يقرأ فروق الجرد المعتمدة",async()=>{try{await maker.inventoryCount.getDifferences();assert.fail("Accountant saw differences");}catch(e:any){assert.equal(e.code,"FORBIDDEN");return{code:e.code};}});
 await check("المالك يرى فرقين للجرد المعتمد فقط",async()=>{const differences=await owner.inventoryCount.getDifferences();const list=Array.isArray(differences)?differences:(differences as any).differences;const own=list.filter((r:any)=>r.sessionId===run.inventorySessionId);assert.equal(own.length,2);return own.map((r:any)=>({id:r.id,difference:r.difference,reason:r.reason}));});
 const user=d.users.find((u:any)=>u.id===run.actors.maker.id),employee=appRouter.createCaller(context({...user,role:"employee",employeeId:first.assignedTo}));
 await check("الموظف يرى ما يخصه دون سجلات موظف آخر",async()=>{const list=await employee.inventory.assets.list({search:run.marker});assert.ok(list.every((r:any)=>r.assignedTo===first.assignedTo));const other=records.find(r=>r.entityType==="asset"&&r.assignedTo!==first.assignedTo&&r.status==="ACTIVE");assert.ok(other);try{await employee.inventory.assets.getById({id:other.id});assert.fail("Leakage");}catch(e:any){assert.equal(e.code,"NOT_FOUND");return {visible:list.length,deniedOtherId:other.id};}});
 await check("البحث برمز الأصل والعهدة يرجع السجل الصحيح للجرد",async()=>{for(const type of ["asset","custody"]){const record=active.find(r=>r.entityType===type),code=record.assetCode??record.code;const found:any=await maker.inventoryCount.lookupByCode({code});assert.equal(found.id,record.id);assert.equal(found.entityType,type);}return {types:2};});
 await check("التقرير التشغيلي شامل ويستبعد المسودات والملغى",async()=>{const list:any=await maker.records.reports.inventory({type:"all",search:run.marker});const rows=Array.isArray(list)?list:list.rows;assert.equal(rows.length,records.filter(r=>!["DRAFT","CANCELLED"].includes(r.status)).length);return {rows:rows.length};});
 await check("رفض مبلغ سالب في API برسالة BAD_REQUEST منظمة",async()=>{const p=run.financialDrafts[0],r=run.records.find((r:any)=>r.id===p.recordId&&r.kind===p.kind);try{await maker.depreciation.saveBatch({entityType:p.kind,entityId:p.recordId,classificationId:r.classificationId,policyId:run.policyId,payload:{...p.payload,unitResidual:"-1"}});assert.fail("Negative input accepted");}catch(e:any){out.invalidInputEvidence={actualCode:e.code,actualMessage:e.message,expectedCode:"BAD_REQUEST"};assert.equal(e.code,"BAD_REQUEST");return{code:e.code};}});
 out.finishedAt=new Date().toISOString();writeFileSync("qa-results/main-readchecks.json",JSON.stringify(out,null,2));
}finally{await db.end();const handle:any=await getDb();await handle?.$client?.end();}
process.exit(0);
