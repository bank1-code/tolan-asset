import "dotenv/config";
import {readFileSync,writeFileSync} from "node:fs";
import {strict as assert} from "node:assert";
import mysql from "mysql2/promise";
import {appRouter} from "../server/routers";
import {getDb} from "../server/db";
const run=JSON.parse(readFileSync("qa-results/run.json","utf8")),financial=JSON.parse(readFileSync("qa-results/financial.json","utf8")),discovery=JSON.parse(readFileSync("qa-results/discovery.json","utf8"));
if(!/^tolan_qa_\d+_[a-f0-9]{8}$/.test(financial.schema)||financial.isolatedDatabaseRemoved)throw new Error("Active isolated QA schema required");
const target=new URL(process.env.DATABASE_URL!);assert.notEqual(target.pathname,`/${financial.schema}`);target.pathname=`/${financial.schema}`;process.env.DATABASE_URL=target.toString();
const sql=mysql.createPool({uri:target.toString(),ssl:{minVersion:"TLSv1.2",rejectUnauthorized:true},connectionLimit:2,maxIdle:1,idleTimeout:30000});
const ctx=(user:any)=>({user,req:{ip:"127.0.0.1",headers:{}},res:{}}as any),makerUser=discovery.users.find((u:any)=>u.id===run.actors.maker.id),maker=appRouter.createCaller(ctx(makerUser)),out:any={checks:[],environment:"قاعدة QA المستقلة فقط"};
async function check(name:string,fn:()=>Promise<any>){try{const evidence=await fn();out.checks.push({name,status:"PASS",evidence});console.log(`PASS ${name}`);}catch(e:any){out.checks.push({name,status:"FAIL",error:e.message,code:e.code});console.log(`FAIL ${name}: ${e.message}`);}writeFileSync("qa-results/transaction-faults.json",JSON.stringify(out,null,2));}
const count=async(table:string)=>Number((await sql.query<any[]>(`SELECT COUNT(*) n FROM \`${table}\``))[0][0].n);
try{
 await check("تراجع إنشاء الأصل كاملاً عندما يفشل Audit Log بعلاقة مستخدم غير موجود",async()=>{const invalid=appRouter.createCaller(ctx({...makerUser,id:900000099})),before=await count("assets");let rejected=false;try{await invalid.inventory.assets.create({...run.records.find((r:any)=>r.kind==="asset"&&r.index===3).payload,assetName:"QA forced audit FK fault"});}catch{rejected=true;}assert.ok(rejected);assert.equal(await count("assets"),before);return{before,after:await count("assets"),rolledBack:true};});
 await check("تراجع اعتماد التصحيح والقيد والحالة عند فشل التدقيق SQL",async()=>{const record=run.records.find((r:any)=>r.kind==="asset"&&r.index===30),batch=run.financialDrafts.find((b:any)=>b.kind==="asset"&&b.recordId===record.id);assert.ok(batch);const saved=await maker.depreciation.saveMovement({batchId:batch.id,kind:"CORRECTION",effectiveDate:"2026-10-01",sourceKey:null,payload:{units:[batch.payload.units[0]],reason:"QA transaction rollback fault",documentReference:"QA-ROLLBACK",proceeds:"0",unitCost:"1000",unitAccumulated:"100",unitImpairment:"0",unitResidual:"0",remainingLifeMonths:24,correctionAccount:"QA تصحيح"}});await maker.depreciation.submitDocument({kind:"movement",id:saved.id!,expectedVersion:0});const before=await count("depreciation_journals"),audits=await count("audit_log"),bad=appRouter.createCaller(ctx({id:900000001,role:"accounting_manager",name:"X".repeat(300)}));let error:any;try{await bad.depreciation.approveDocument({kind:"movement",id:saved.id!,expectedVersion:1});}catch(e){error=e;}assert.ok(error,"Expected deliberate SQL fault");const [ownJournals]=await sql.query<any[]>("SELECT COUNT(*) n FROM depreciation_journals WHERE movementId=?",[saved.id]);assert.equal(Number(ownJournals[0].n),0);const [ownAudits]=await sql.query<any[]>("SELECT COUNT(*) n FROM audit_log WHERE tableName=\"depreciation_movements\" AND recordId=? AND actionType=\"FINANCE_APPROVE\"",[saved.id]);assert.equal(Number(ownAudits[0].n),0);const [rows]=await sql.query<any[]>("SELECT status,version FROM depreciation_movements WHERE id=?",[saved.id]);assert.equal(rows[0].status,"SUBMITTED");assert.equal(rows[0].version,1);return{movementId:saved.id,status:rows[0].status,journalCreated:false,errorCode:error.code};});
}finally{await sql.end();const db:any=await getDb();await db?.$client?.end();}
process.exit(0);
