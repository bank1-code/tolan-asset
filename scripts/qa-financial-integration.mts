 await check("إعادة اعتماد سبتمبر ثم الإقفال المتسلسل ومنع عكس المقفل",async()=>{const last=result.monthly.at(-1);const[rows]=await isolated.query<any[]>("SELECT version FROM depreciation_periods WHERE id=?",[last.periodId]);await maker.depreciation.savePeriod({month:last.period,expectedVersion:rows[0].version});const [draft]=await isolated.query<any[]>("SELECT version FROM depreciation_periods WHERE id=?",[last.periodId]);await maker.depreciation.submitPeriod({id:last.periodId,expectedVersion:draft[0].version});await manager.depreciation.approvePeriod({id:last.periodId,expectedVersion:draft[0].version+1});for(const month of result.monthly){const[p]=await isolated.query<any[]>("SELECT version FROM depreciation_periods WHERE id=?",[month.periodId]);await manager.depreciation.closePeriod({id:month.periodId,expectedVersion:p[0].version});}const[closed]=await isolated.query<any[]>("SELECT version FROM depreciation_periods WHERE id=?",[last.periodId]);return denied(()=>manager.depreciation.reversePeriod({id:last.periodId,expectedVersion:closed[0].version,reason:"غير مسموح"}),["BAD_REQUEST"]);});
 await check("تغيير تقدير أكتوبر يؤثر مستقبلاً دون تعديل سبتمبر",async()=>{const selected=state.batches.find((b:any)=>b.rule.treatment==="DEPRECIABLE"&&b.payload.availableForUseDate==="2026-01-16"&&!state.movements.some((m:any)=>m.batchId===b.id));assert.ok(selected);const before=await maker.depreciation.report({from:"2026-09-01",to:"2026-09-30"});await approveMovement({batchId:selected.id,kind:"ESTIMATE",effectiveDate:"2026-10-01",sourceKey:null,payload:{units:[selected.payload.units[0]],reason:"تغيير تقدير مستقبلي QA",documentReference:"QA-EST",proceeds:"0.00",remainingLifeMonths:24,unitResidual:"100.00"}});const after=await maker.depreciation.report({from:"2026-09-01",to:"2026-09-30"});assert.deepEqual(after.total,before.total);return {batchId:selected.id,effectiveDate:"2026-10-01"};});
 await check("تصحيح أكتوبر مستقل والقيد متوازن دون تعديل ملف الأصل",async()=>{const selected=state.batches.find((b:any)=>b.rule.treatment==="DEPRECIABLE"&&b.payload.availableForUseDate==="2026-03-10"&&!state.movements.some((m:any)=>m.batchId===b.id));assert.ok(selected);const [before]=await isolated.query<any[]>("SELECT payload FROM depreciation_batches WHERE id=?",[selected.id]);await approveMovement({batchId:selected.id,kind:"CORRECTION",effectiveDate:"2026-10-01",sourceKey:null,payload:{units:[selected.payload.units[0]],reason:"تصحيح مستقل QA",documentReference:"QA-COR",proceeds:"0.00",remainingLifeMonths:48,unitResidual:"100.00",unitCost:"9000.00",unitAccumulated:"1000.00",unitImpairment:"250.00",correctionAccount:"تسويات تصحيح QA"}});const[after]=await isolated.query<any[]>("SELECT payload FROM depreciation_batches WHERE id=?",[selected.id]);assert.deepEqual(after[0].payload,before[0].payload);return {batchId:selected.id};});
 await check("مطابقة أكتوبر التقديرية بعد التصحيح وتغيير العمر مع مرجع مستقل",async()=>{const state=await financialState(db),oracleResult=oracle(state,"2026-10-31"),preview=await maker.depreciation.previewPeriod({month:"2026-10"});const amount=[...oracleResult.monthly].filter(([key])=>key.startsWith("2026-10")).reduce((n,[,v])=>n+v,0n);assert.equal(cents(preview.snapshot.total),amount);return {expected:decimal(amount),actual:preview.snapshot.total};});
