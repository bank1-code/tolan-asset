function oracle(state:any,to:string){const monthly=new Map<string,bigint>(),units:any[]=[];
 for(const b of state.batches){const p=b.payload;if(p.balanceDate>to)continue;
  p.units.forEach((unit:string,index:number)=>{const split=(total:bigint)=>total/BigInt(p.quantity)+(BigInt(index)<total%BigInt(p.quantity)?1n:0n);let cost=cents(p.unitCost),accum=split(cents(p.openingAccumulated)),imp=split(cents(p.openingAccumulated)+cents(p.openingImpairment))-accum,resid=cents(p.unitResidual),life=p.lifeMonths,base=cost-accum-imp-resid, numerator=0n,denominator=1n,lastRounded=0n,disposed=false,allocation=p.allocation;
   const events=state.movements.filter((m:any)=>m.batchId===b.id&&m.payload.units.includes(unit));
   let ready=p.availableForUseDate;if(b.partialMonth==="NEXT_MONTH"&&!ready.endsWith("-01")){const date=new Date(`${ready}T00:00:00Z`);ready=new Date(Date.UTC(date.getUTCFullYear(),date.getUTCMonth()+1,1)).toISOString().slice(0,10);}
   for(let date=p.balanceDate;date<=to;date=tomorrow(date)){
    for(const e of events.filter((m:any)=>m.effectiveDate===date)){
     if(["DISPOSAL","WARRANTY"].includes(e.kind))disposed=true;
     if(e.kind==="TRANSFER")allocation=e.payload.allocation;
     if(e.kind==="CORRECTION"){cost=cents(e.payload.unitCost);accum=cents(e.payload.unitAccumulated);imp=cents(e.payload.unitImpairment);}
     if(["CORRECTION","ESTIMATE"].includes(e.kind)){resid=cents(e.payload.unitResidual);life=e.payload.remainingLifeMonths;base=cost-accum-imp-resid;if(base<0n)base=0n;numerator=0n;denominator=1n;lastRounded=0n;}
    }
    if(disposed)break;if(date<ready||b.rule.treatment!=="DEPRECIABLE"||base===0n)continue;
    const parsed=new Date(`${date}T00:00:00Z`),days=BigInt(new Date(Date.UTC(parsed.getUTCFullYear(),parsed.getUTCMonth()+1,0)).getUTCDate()),divisor=BigInt(life)*days;
    numerator=numerator*divisor+base*denominator;denominator*=divisor;const factor=gcd(numerator,denominator);numerator/=factor;denominator/=factor;
    let rounded=(2n*numerator+denominator)/(2n*denominator);if(rounded>base)rounded=base;const delta=rounded-lastRounded;lastRounded=rounded;accum+=delta;
    const key=`${date.slice(0,7)}:${b.id}:${unit}`;monthly.set(key,(monthly.get(key)??0n)+delta);
   }
   units.push({batchId:b.id,unit,cost:disposed?0n:cost,accum:disposed?0n:accum,imp:disposed?0n:imp,resid,disposed,allocation,classificationId:b.classificationId});
  });
 }
 return {monthly,units,cost:units.reduce((n,u)=>n+u.cost,0n),accum:units.reduce((n,u)=>n+u.accum,0n),imp:units.reduce((n,u)=>n+u.imp,0n)};
}
